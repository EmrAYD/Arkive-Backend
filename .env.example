# Docker KULLANMADAN çalıştırma için. Kopyalayın: backend klasöründe  .env  adıyla.
# (Docker kullanıyorsanız bu dosya gerekmez, kökteki .env.example kullanılır.)

# Yerel geliştirme için SQLite: kurulum gerektirmez, veri backend/arkive.db dosyasında tutulur.
DATABASE_URL=sqlite:///./arkive.db

# PostgreSQL'e geçmek isterseniz (kendi bilgisayarınıza kurduysanız):
# DATABASE_URL=postgresql+psycopg://postgres:SIFRENIZ@localhost:5432/arkive

# Firebase konsolu > Proje ayarları > Proje kimliği (google-services.json içindeki "project_id").
# DİKKAT: "1080695114808" gibi proje NUMARASI değil, proje KİMLİĞİ (ör. arkive-12345).
FIREBASE_PROJECT_ID=firebase-proje-kimliginiz

# --- Dosya depolama (RustFS) ---
# RustFS'i başlatırken kullandığınız RUSTFS_ACCESS_KEY / RUSTFS_SECRET_KEY değerleri.
S3_ACCESS_KEY=rustfs-access-key
S3_SECRET_KEY=rustfs-secret-key
S3_BUCKET=arkive-files
# Backend'in RustFS'e bağlandığı adres (aynı bilgisayarda: localhost).
S3_ENDPOINT=http://localhost:9000
# Telefonun/emülatörün RustFS'e bağlandığı adres. Emülatör: http://10.0.2.2:9000
# Gerçek telefon: bilgisayarın yerel IP'si, ör. http://192.168.1.20:9000 (RustFS 0.0.0.0'a bağlanmalı).
S3_PUBLIC_ENDPOINT=http://10.0.2.2:9000
